# Backend Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://precursor:precursor_dev@localhost:5432/precursorai
USE_CREATE_ALL=false

# LLM Config
LLM_PROVIDER=gemini # gemini/ollama
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Security & Auth
JWT_SECRET=SUPER_SECRET_CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173"]

# Redis
REDIS_URL=redis://localhost:6379

# Tier 1 Settings
CONFIDENCE_THRESHOLD=0.75   # Reports below this go to human review
RAG_TOP_K=5                 # Number of knowledge chunks retrieved per report

# Tier 2 Settings
COGNITION_SIMILARITY_THRESHOLD=0.80   # Cosine similarity threshold for connected components
COGNITION_MIN_REPORTS=3               # Minimum reports to form a pattern
