# Backend Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://precursor:precursor_dev@localhost:5432/precursorai

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Tier 1 Settings
CONFIDENCE_THRESHOLD=0.75   # Reports below this go to human review
RAG_TOP_K=5                 # Number of knowledge chunks retrieved per report

# Tier 2 Settings
COGNITION_SIMILARITY_THRESHOLD=0.80   # Cosine similarity threshold for connected components
COGNITION_MIN_REPORTS=3               # Minimum reports to form a pattern
